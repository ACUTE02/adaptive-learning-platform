# Copy to .env on the server:  cp .env.prod.example .env   then fill every REPLACE_ME.
# Never commit .env. Use letters and digits only in passwords and keys (no $ " ' # or spaces);
# the easy way to make one:  openssl rand -hex 32

# ---- Domain and HTTPS ------------------------------------------------------
# Your domain, no https:// and no trailing slash. Its A record must point to the Elastic IP.
DOMAIN=REPLACE_ME.example.com
# Email Let's Encrypt uses for certificate expiry notices
ACME_EMAIL=REPLACE_ME@example.com
# Browser origins the API accepts (comma separated). Use https://<your domain>
LEARNHOUSE_ALLOWED_ORIGINS=https://REPLACE_ME.example.com

# ---- Secrets (generate each with: openssl rand -hex 32) ---------------------
LEARNHOUSE_AUTH_JWT_SECRET_KEY=REPLACE_ME_64_HEX_CHARS
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
# Required by the API in production even though the collab server is not deployed
COLLAB_INTERNAL_KEY=REPLACE_ME_RANDOM_KEY
# Google Gemini key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=REPLACE_ME_GEMINI_KEY

# ---- Accounts --------------------------------------------------------------
# First admin. Created automatically on the first start (and by create_users.py).
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@REPLACE_ME.example.com
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD
# Demo student, created by create_users.py. Leave both empty to skip.
DEMO_STUDENT_EMAIL=student@REPLACE_ME.example.com
DEMO_STUDENT_PASSWORD=REPLACE_ME_STUDENT_PASSWORD
# Accounts the daily knowledge-decay job skips (comma separated emails, may be empty)
DECAY_EXCLUDED_USERS=

# ---- Web (Next.js) NEXT_PUBLIC_* ------------------------------------------
# BACKEND_URL, DOMAIN and ENV are baked into the web image at BUILD time (compose passes them
# as build args) and also read at runtime. If you change them, rebuild:
#   docker compose -f docker-compose.prod.yml up -d --build web
# They must use the same domain as DOMAIN above. Trailing slash on BACKEND_URL is required.
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://REPLACE_ME.example.com/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=REPLACE_ME.example.com
NEXT_PUBLIC_LEARNHOUSE_ENV=production
# Runtime-only (no rebuild needed):
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=REPLACE_ME.example.com
NEXT_PUBLIC_LEARNHOUSE_HTTPS=true
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default
