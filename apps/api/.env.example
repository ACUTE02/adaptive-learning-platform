# Copy to .env and fill in. Never commit the real .env.

# development | production. In production the API refuses to start with an
# empty or placeholder COLLAB_INTERNAL_KEY and serves no /docs, /redoc or /openapi.json.
ENVIRONMENT=development
# true = also expose /docs, /redoc and /openapi.json in production (leave unset normally)
# LEARNHOUSE_ENABLE_API_DOCS=false

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
LEARNHOUSE_AUTH_JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# REQUIRED in production: put a NEW random key here (yahan naya random key daalo).
# Same value as in apps/collab/.env. Generate it the same way as the JWT secret.
COLLAB_INTERNAL_KEY=REPLACE_WITH_A_NEW_RANDOM_KEY

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY

# Optional: accounts that the daily knowledge-decay job skips (comma separated)
# DECAY_EXCLUDED_USERS=admin@school.dev
