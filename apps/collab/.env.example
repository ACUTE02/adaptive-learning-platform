COLLAB_PORT=4000
LEARNHOUSE_API_URL=http://localhost:1338
LEARNHOUSE_AUTH_JWT_SECRET_KEY=your-jwt-secret-key
# REQUIRED in production: put a NEW random key here (yahan naya random key daalo).
# It must be the same value in the API environment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start in production with this placeholder or the old public default.
COLLAB_INTERNAL_KEY=REPLACE_WITH_A_NEW_RANDOM_KEY
